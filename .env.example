
VITE_API_URL=http://localhost:5000

# Artificial delay used by the task-created EventEmitter listener (Practical 10)
NOTIFICATION_DELAY_MS=2000

# ─── Host development ──────────────────────────────────────────────────────────
# Application Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# Example Local: mongodb://localhost:27017/taskdb
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.vrc2cfd.mongodb.net/taskmanager
MONGO_URI=mongodb://localhost:27017/taskdb
MONGODB_URI=mongodb://localhost:27017/taskdb

# JWT Authentication
# Generate a strong secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=your_secret_key
JWT_EXPIRES_IN=1h

# In-Memory Task Cache (node-cache)
CACHE_TTL_SECONDS=60
# Set to false to bypass the cache (used for before/after benchmarking)
CACHE_ENABLED=true

# Optional Access Keys
VITE_WEB3FORMS_ACCESS_KEY=YOUR_ACCESS_KEY_HERE
